<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme with Material You dynamic color support -->
    <style name="Theme.ObscuraBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary color extracted from wallpaper -->
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryContainer">@color/primary_100</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        
        <!-- Secondary color -->
        <item name="colorSecondary">@color/secondary_500</item>
        <item name="colorSecondaryContainer">@color/secondary_100</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_700</item>
        
        <!-- Background colors -->
        <item name="colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Window insets -->
        <item name="windowInsetPaddingBottom">0dp</item>
        <item name="windowInsetPaddingTop">0dp</item>
    </style>
    
    <!-- Toolbar style -->
    <style name="Widget.ObscuraToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ObscuraToolbarTitle</item>
        <item name="navigationIcon">@drawable/ic_arrow_back</item>
        <item name="menuNavigationIcon">@drawable/ic_menu</item>
    </style>
    
    <style name="TextAppearance.ObscuraToolbarTitle" parent="TextAppearance.Material3.Toolbar.Title">
        <item name="fontFamily">@font/roboto_medium</item>
    </style>
    
    <!-- Bottom Navigation -->
    <style name="BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="background">@color/primary_50</item>
        <item name="itemIconTint">@color/bottom_nav_icon_tint</item>
        <item name="itemTextColor">@color/bottom_nav_text_tint</item>
    </style>
    
    <!-- Tab layout -->
    <style name="TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.ObscuraTab</item>
        <item name="tabIconTint">@color/tab_icon_tint</item>
        <item name="tabTextColor">@color/tab_text_color</item>
    </style>
    
    <style name="TextAppearance.ObscuraTab" parent="TextAppearance.Material3.Tab">
        <item name="fontFamily">@font/roboto_medium</item>
    </style>
</resources>