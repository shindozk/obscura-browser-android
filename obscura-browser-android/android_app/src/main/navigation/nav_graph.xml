<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/main_fragment">

    <fragment
        android:id="@+id/main_fragment"
        android:name="com.obscura.browser.ui.BrowserFragment"
        android:label="@string/app_name" >
        <action
            android:id="@+id/action_main_fragment_to_home_fragment"
            app:destination="@id/home_fragment" />
        <action
            android:id="@+id/action_main_fragment_to_tab_fragment"
            app:destination="@id/tab_fragment" />
        <action
            android:id="@+id/action_main_fragment_to_bookmarks_fragment"
            app:destination="@id/bookmarks_fragment" />
        <action
            android:id="@+id/action_main_fragment_to_settings_fragment"
            app:destination="@id/settings_fragment" />
    </fragment>

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.obscura.browser.ui.HomeFragment"
        android:label="@string/title_home" />

    <fragment
        android:id="@id/tab_fragment"
        android:name="com.obscura.browser.ui.TabFragment"
        android:label="@string/tabs" />

    <fragment
        android:id="@id/bookmarks_fragment"
        android:name="com.obscura.browser.ui.BookmarksFragment"
        android:label="@string/bookmarks" />

    <fragment
        android:id="@id/settings_fragment"
        android:name="com.obscura.browser.ui.SettingsFragment"
        android:label="@string/settings" />